    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/apply/ready-to-apply",
      "regex": "^/apply/ready\\-to\\-apply(?:/)?$",
      "routeKeys": {},
