    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/program-list",
      "regex": "^/program\\-list(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/program\\-list(?:/)?$"
    },
    {
      "page": "/study/extended-education",
      "regex": "^/study/extended\\-education(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/study/extended\\-education(?:/)?$"
    }
