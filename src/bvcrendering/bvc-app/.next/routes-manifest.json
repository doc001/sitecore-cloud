        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/apply/i\\-am\\-ready/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/study/extended-education/courses/[sisID]",
