        "nxtPsisID": "nxtPsisID"
      },
      "namedRegex": "^/study/open\\-studies/courses/(?<nxtPsisID>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
