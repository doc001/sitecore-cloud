[["$","div",null,{"className":"min-h-screen bg-background","children":[["$","section",null,{"className":"bg-program-gradient text-white py-16","children":["$","div",null,{"className":"container-layout","children":["$","div",null,{"className":"max-w-4xl mx-auto text-center","children":[["$","h1",null,{"className":"text-4xl md:text-6xl font-bold mb-6","children":"Our Programs"}],["$","p",null,{"className":"text-xl md:text-2xl font-light opacity-90","children":"Discover your path to success with our diverse range of programs designed to prepare you for today's dynamic workforce."}]]}]}]}],["$","section",null,{"className":"bg-neutral-5 py-4","children":["$","div",null,{"className":"container-layout","children":["$","nav",null,{"aria-label":"Breadcrumb","className":"flex items-center space-x-2 text-sm","children":[["$","a",null,{"href":"/","className":"text-neutral-60 hover:text-blue-100 transition-colors duration-200","children":"Home"}],["$","span",null,{"className":"text-neutral-40","children":"/"}],["$","span",null,{"className":"text-neutral-80 font-medium","children":"Programs"}]]}]}]}],["$","main",null,{"className":"container-layout","children":["$","div",null,{"className":"py-8","children":[["$","div",null,{"className":"max-w-3xl mb-12","children":[["$","h2",null,{"className":"text-2xl md:text-3xl font-semibold text-neutral-80 mb-4","children":"Find Your Perfect Program"}],["$","p",null,{"className":"text-lg text-neutral-60 leading-relaxed","children":"Whether you're looking to start a new career, advance in your current field, or upgrade your skills, we have a program that's right for you. Browse through our offerings and take the first step toward your future."}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-3 gap-6 mb-12","children":[["$","div",null,{"className":"bg-white p-6 rounded-lg shadow-sm border border-neutral-10","children":[["$","div",null,{"className":"text-3xl font-bold text-blue-100 mb-2","children":52}],["$","div",null,{"className":"text-neutral-60","children":"Total Programs"}]]}],["$","div",null,{"className":"bg-white p-6 rounded-lg shadow-sm border border-neutral-10","children":[["$","div",null,{"className":"text-3xl font-bold text-purple-100 mb-2","children":8}],["$","div",null,{"className":"text-neutral-60","children":"Schools"}]]}],["$","div",null,{"className":"bg-white p-6 rounded-lg shadow-sm border border-neutral-10","children":[["$","div",null,{"className":"text-3xl font-bold text-orange-100 mb-2","children":8}],["$","div",null,{"className":"text-neutral-60","children":"Program Types"}]]}]]}],["$","$L7",null,{"programs":[{"name":"Addiction Studies","programType":"diploma","availableIntakes":"aasd-fall-2025; aasd-winter-2026","slug":"addiction-studies-diploma","shortDescription":"Do you want to become an addiction practitioner? You will enjoy both classroom and practicum learning opportunities in this program. Let us help you reach your goal.","duration":"4-terms","code":"AASD","school":"school-of-community-studies","programArea":"community-studies","pgwp":true},{"name":"Administrative Professional","programType":"certificate","availableIntakes":"oa-fall-2025; oa-winter-2026","slug":"administrative-professional","shortDescription":"Learn the technical and interpersonal skills you need to be an effective administrative professional. You'll be ready to meet the demands of every business office.","duration":"3-terms","code":"OA","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Advanced 3D Animation & 3D Modelling","programType":"diploma","availableIntakes":"3dam-fall-2025; 3dam-winter-2026","slug":"advanced-3d-animation-3d-modelling","shortDescription":"This Centre for Entertainment Arts (CEA) program focuses on 3D Animation and 3D Modelling and its various departmental specializations, such as 3D animation (character and creature), rigging, 3D modelling & sculpting, and texturing/surfacing.","duration":"6-terms","code":"3DAM","school":"centre-for-entertainment-arts","programArea":"entertainment-arts","pgwp":false},{"name":"Advanced Film Production","programType":"diploma","availableIntakes":"afp-fall-2025; afp-winter-2026","slug":"advanced-film-production","shortDescription":"Advanced Film Production is a full time, two-year program comprising the five principle domains of live action film development.","duration":"6-terms","code":"AFP","school":"centre-for-entertainment-arts","programArea":"entertainment-arts","pgwp":false},{"name":"Advanced Game Development","programType":"diploma","availableIntakes":"agd-fall-2025; agd-winter-2026","slug":"advanced-game-development","shortDescription":"This program is comprised of industry-level courses covering game development's core disciplines: art, design, programming, and production.","duration":"6-terms","code":"AGD","school":"centre-for-entertainment-arts","programArea":"entertainment-arts","pgwp":true},{"name":"Advanced Visual Effects (Virtual Production)","programType":"diploma","availableIntakes":"avfx-winter-2026; avfx-fall-2025","slug":"advanced-visual-effects","shortDescription":"In this Centre for Entertainment Arts (CEA) diploma, students will study numerous specializations in VFX, such as modelling, sculpting, texturing/surfacing, lighting, compositing, and FX.","duration":"6-terms","code":"AVFX","school":"centre-for-entertainment-arts","programArea":"entertainment-arts","pgwp":false},{"name":"Business Administration - Accounting Major","programType":"diploma","availableIntakes":"baa-fall-2025","slug":"business-administration---accounting-major","shortDescription":"Practical skills that count. Technical knowledge that adds up. Gain a broad understanding of business with a focus on the development of job-ready accounting skills needed for a successful accounting career.","duration":"4-terms","code":"BAA","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Business Administration - Certificate","programType":"certificate","availableIntakes":"afm-fall-2025; afm-winter-2026","slug":"business-administration---certificate","shortDescription":"A dynamic career that can take you anywhere in the world. Learn the skills that are the backbone of today's businesses.","duration":"2-terms","code":"AFM","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Business Administration - Financial Services Major","programType":"diploma","availableIntakes":"bafs-fall-2025","slug":"business-administration---financial-services-major","shortDescription":"This sought-after career destination is for the quick thinking, ambitious professional. The financial services sector is fast paced, customer focused, and constantly innovating. Good news for those wanting a dynamic and diverse career.","duration":"4-terms","code":"BAFS","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Business Administration - General Business Major","programType":"diploma","availableIntakes":"bagb-fall-2025","slug":"business-administration---general-business-major","shortDescription":"The General Business Major is designed to provide students with pathways to further their post-secondary studies at various universities. Graduates gain a broad understanding of a multitude of business concepts.","duration":"4-terms","code":"BAGB","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Business Administration - Human Resources Major","programType":"diploma","availableIntakes":"bahr-fall-2025","slug":"business-administration---human-resources-major","shortDescription":"Explore the influential role human resources (HR) professionals carry in organizations to align company strategy with HR practices. Gain job-ready skills and learn how to link HR strategies with organizational objectives to support business success. Designed with busy lives in mind, this program offers flexible course options that fit your schedule. You can advance your education without putting life on hold.","duration":"4-terms","code":"BAHR","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Business Administration - Insurance and Risk Management Major","programType":"diploma","availableIntakes":"barm-fall-2025; barm-winter-2026","slug":"business-administration---insurance-and-risk-management-major","shortDescription":"Be a part of a dynamic industry. A career in insurance and risk management offers flexibility with client interaction, teamwork, networking, and professional growth.","duration":"4-terms","code":"BARM","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Business Administration - Integrated Marketing Communications Major","programType":"diploma","availableIntakes":"bam-fall-2025","slug":"business-administration---integrated-marketing-communications-major","shortDescription":"Get ready to work in a fast-paced, creative industry that evolves quickly. You'll learn how to create and foster value in the marketplace with a forward-thinking attitude.","duration":"4-terms","code":"BAM","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Business Administration - Supply Chain Management  Major","programType":"diploma","availableIntakes":"basc-fall-2025","slug":"business-administration---supply-chain-management-major","shortDescription":"Work in supply chain management and improve a company's efficiency by managing the flow of products, services, and information.","duration":"4-terms","code":"BASC","school":"chiu-school-of-business","programArea":"business","pgwp":true},{"name":"Child and Youth Care","programType":"diploma","availableIntakes":"cycd-fall-2025; cycd-winter-2026","slug":"child-and-youth-care","shortDescription":"Make a positive impact in the lives of children, youth, and families. Prepare for a career supporting children and their families who have experienced adversity such as childhood trauma, oppression, systemic discrimination, mental health or substance use.","duration":"4-terms","code":"CYCD","school":"school-of-community-studies","programArea":"community-studies","pgwp":false},{"name":"Cybersecurity - Post-Diploma Certificate","programType":"post-diploma-certificate","availableIntakes":"csp-fall-2025; csp-winter-2026","slug":"cybersecurity---post-diploma-certificate","shortDescription":"Learn how to secure information and network systems from threats","duration":"2-terms","code":"CSP","school":"school-of-technology","programArea":"technology","pgwp":true},{"name":"Data Management and Analytics - Post-Diploma Certificate","programType":"post-diploma-certificate","availableIntakes":"dma-fall-2025; dma-winter-2026","slug":"data-management-and-analytics---post-diploma-certificate","shortDescription":"The Data Management and Analytics Post-Diploma Certificate prepares learners to uncover insights from unstructured data sets to inform data-driven decision making.","duration":"2-terms","code":"DMA","school":"school-of-technology","programArea":"technology","pgwp":true},{"name":"Digital Design","programType":"diploma","availableIntakes":"dd-fall-2025; dd-winter-2026","slug":"digital-design","shortDescription":"Get the skills you need to design and create websites, e-publications, applications, and interactive multimedia products.","duration":"4-terms","code":"DD","school":"school-of-technology","programArea":"technology","pgwp":true},{"name":"Digital Design - Apprenticeship Style","programType":"diploma","availableIntakes":"ddas-fall-2025; ddas-winter-2026","slug":"digital-design---apprenticeship-style","shortDescription":"Gain real-world knowledge and practical experience in graphic design. Learn UI/UX design, motion graphics, and audio and video development while working as a designer.","duration":"4-terms","code":"DDAS","school":"school-of-technology","programArea":"technology","pgwp":false},{"name":"Digital Marketing - Post-Diploma Certificate","programType":"post-diploma-certificate","availableIntakes":"dmp-fall-2025; dmp-winter-2026","slug":"digital-marketing---post-diploma-certificate","shortDescription":"Enhance your existing diploma or degree. Add vital marketing and communication skills in the area of digital marketing.","duration":"2-terms","code":"DMP","school":"school-of-technology","programArea":"technology","pgwp":true},{"name":"Disability Studies","programType":"diploma","availableIntakes":"dcsd-fall-2025; dcsd-winter-2026","slug":"disability-studies","shortDescription":"Graduates are equipped to enhance the quality of life and well-being of people with disabilities while taking an active role in creating inclusive and diverse communities.","duration":"4-terms","code":"DCSD","school":"school-of-community-studies","programArea":"community-studies","pgwp":true},{"name":"Early Childhood Education and Development","programType":"certificate","availableIntakes":"ece-fall-2025; ece-winter-2026","slug":"early-childhood-education-and-development","shortDescription":"Make a difference in the lives of children, families, and communities by providing, and leading, quality early learning and child care in many settings. Become eligible for Level 2 Early Childhood Educator Certification from the Alberta Government.","duration":"2-terms","code":"ECE","school":"school-of-community-studies","programArea":"community-studies","pgwp":true},{"name":"Early Childhood Education and Development","programType":"diploma","availableIntakes":"eced-fall-2025; eced-winter-2026","slug":"early-childhood-education-and-development-diploma","shortDescription":"Make a difference in the lives of children, families, and communities by providing, and leading, quality early learning and child care in many settings. Become eligible for Level 3 Early Childhood Educator Certification from the Alberta Government.","duration":"4-terms","code":"ECED","school":"school-of-community-studies","programArea":"community-studies","pgwp":true},{"name":"Education Assistant","programType":"certificate","availableIntakes":"ea-fall-2025; ea-winter-2026","slug":"education-assistant","shortDescription":"Make a positive impact working with children who have diverse learning needs.","duration":"2-terms","code":"EA","school":"school-of-community-studies","programArea":"community-studies","pgwp":true},{"name":"English for Academic Purposes","programType":"non-credential","availableIntakes":"eap-fall-2025","slug":"english-for-academic-purposes","shortDescription":"Improve your academic English. Gain the skills you need to study at a Canadian post-secondary school.","duration":"1-3-terms","code":"ELL","school":"school-of-foundational-learning","programArea":"english","pgwp":false},{"name":"Esports Business Management","programType":"diploma","availableIntakes":"ebm-fall-2025; ebm-winter-2026","slug":"esports-business-management","shortDescription":"Get the tools needed to enter one of the fastest-growing global industries, Esports and gaming!","duration":"4-terms","code":"EBM","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Financial Planning Certificate of Achievement","programType":"certificate-of-achievement","availableIntakes":"fp-bvc-fall-2025; fp-bvc-spring-2025","slug":"financial-planning","shortDescription":"Launch your new career in Financial Planning!","duration":"2-terms","code":"FP-BVC","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Foundation in Entertainment Arts","programType":"certificate","availableIntakes":"fea-fall-2025; fea-winter-2025","slug":"foundation-in-entertainment-arts","shortDescription":"This Centre for Entertainment Arts (CEA) certificate program prepares you for advanced studies in animation, modelling, visual effects, or game development.","duration":"3-terms","code":"FEA","school":"centre-for-entertainment-arts","programArea":"entertainment-arts","pgwp":false},{"name":"Health Care Aide","programType":"certificate","availableIntakes":"heca-fall-2025; heca-winter-2026","slug":"health-care-aide","shortDescription":"The Health Care Aide program will provide you with the opportunity to gain knowledge and hands-on skills to provide person-centered care within a health care team.","duration":"2-terms","code":"HECA","school":"school-of-health-and-wellness","programArea":"health-wellness","pgwp":true},{"name":"Health Data Analytics Diploma","programType":"diploma","availableIntakes":"hda-fall-2025; hda-winter-2026","slug":"health-data-analytics-diploma","shortDescription":"Play a key role in the health care industry by mastering the art of converting unstructured data into actionable insights.","duration":"4-terms","code":"HDA","school":"school-of-technology","programArea":"technology","pgwp":true},{"name":"Health and Human Services Management","programType":"post-diploma-certificate","availableIntakes":"hhsm-fall-2025; hhsm-winter-2025","slug":"health-and-human-services-management","shortDescription":"Become a leader in health and human services. Develop skills and knowledge in management by building on your health or human services diploma or degree.","duration":"2-terms","code":"HHSM","school":"school-of-community-studies","programArea":"community-studies","pgwp":false},{"name":"High School","programType":"upgrading","availableIntakes":"upgr-fall-2025; upgr-winter-2026","slug":"high-school","shortDescription":"Get set for a career program at Bow Valley College or complete the high school courses you need to pursue a post-secondary education.","duration":"","code":"UPGR","school":"school-of-foundational-learning","programArea":"academic-upgrading","pgwp":false},{"name":"Human Resources","programType":"certificate","availableIntakes":"hrm-fall-2025; hrm-winter-2026","slug":"human-resources","shortDescription":"Become part of one of the most essential departments in any organization and discover the many sides of human resources.","duration":"2-terms","code":"HRM","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Indigenous Foundational Learning","programType":"upgrading","availableIntakes":"","slug":"indigenous-foundational-learning","shortDescription":"Develop your foundational academic skills through culturally relevant programming for Indigenous learners.","duration":"","code":"UPGR-IFL","school":"school-of-foundational-learning","programArea":"academic-upgrading","pgwp":false},{"name":"Information Technology Systems","programType":"diploma","availableIntakes":"its-fall-2025; its-winter-2026","slug":"information-technology-systems","shortDescription":"Our Information Technology Systems (ITS) Diploma will give you the hardware and software skills required for the generation, storage, retrieval, transmission, and protection of digital information.","duration":"4-terms","code":"ITS","school":"school-of-technology","programArea":"technology","pgwp":true},{"name":"Interdisciplinary Therapy Assistant","programType":"diploma","availableIntakes":"idta-fall-2025; idta-winter-2026","slug":"interdisciplinary-therapy-assistant","shortDescription":"Acquire knowledge and hands-on experience for a fulfilling career in interdisciplinary rehabilitation therapy.","duration":"6-terms","code":"IDTA","school":"school-of-health-and-wellness","programArea":"health-wellness","pgwp":true},{"name":"Interior Decorating","programType":"diploma","availableIntakes":"its-fall-2025; its-winter-2026","slug":"interior-decorating","shortDescription":"Decorate a new home or office, or redecorate an existing one with style and confidence. Get the skills you need for an exciting career in interior decorating.","duration":"4-terms","code":"IDMD","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Justice Studies - General","programType":"diploma","availableIntakes":"js-fall-2025; jsg-fall-2025","slug":"justice-studies---general","shortDescription":"Do you want a career in justice? A Justice Studies Diploma with a General specialization opens doors to many opportunities.","duration":"4-terms","code":"JSG","school":"school-of-community-studies","programArea":"community-studies","pgwp":false},{"name":"Legal Assistant","programType":"diploma","availableIntakes":"lad-fall-2025; lad-winter-2026","slug":"legal-assistant","shortDescription":"Behind every good lawyer is a great assistant. Legal assistants are highly skilled administrators who work with lawyers on a wide variety of legal matters.","duration":"5-terms","code":"LAD","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Machine Learning Analyst","programType":"diploma","availableIntakes":"mlad-fall-2025; mlad-winter-2026","slug":"machine-learning-analyst","shortDescription":"This program will prepare you for entry-level job roles creating artificial intelligence and machine learning driven business solutions for companies of all sizes.","duration":"4-terms","code":"MLAD","school":"school-of-technology","programArea":"technology","pgwp":true},{"name":"Medical Office Assistant and Unit Clerk","programType":"certificate","availableIntakes":"moa-fall-2025; moa-winter-2026","slug":"medical-office-assistant-and-unit-clerk","shortDescription":"Play a vital role in supporting the best patient care and helping health organizations run smoothly.","duration":"2-terms","code":"MOA","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Path2Practice for IENs","programType":"","availableIntakes":"","slug":"path2practiceforiens","shortDescription":"This program helps bridge your nursing qualifications and experience with what is needed to meet the healthcare standards and work requirements in Alberta.","duration":"3-terms","code":"","school":"pivot-ed","programArea":"health-wellness","pgwp":false},{"name":"Perioperative Nursing for Registered Nurses and Licensed Practical Nurses","programType":"post-diploma-certificate","availableIntakes":"pon-winter-2026; pon-fall-2025","slug":"perioperative-nursing-for-registered-nurses-and-licensed-practical-nurses","shortDescription":"This program will provide LPNs with the required advanced practice education to work in a perioperative setting. Registered Nurses will gain additional knowledge and skills to provide safe, competent care in a perioperative setting.","duration":"22-weeks","code":"PNRN-LPN","school":"school-of-health-and-wellness","programArea":"health-wellness","pgwp":false},{"name":"Pharmacy Technician","programType":"diploma","availableIntakes":"pte-fall-2025; pte-winter-2026","slug":"pharmacy-technician","shortDescription":"Study to prepare compounds and sterile products, and to dispense medications. This full-time program includes both community and hospital practicum placements.","duration":"4-terms","code":"PTE","school":"school-of-health-and-wellness","programArea":"health-wellness","pgwp":true},{"name":"Practical Nurse","programType":"diploma","availableIntakes":"pn-fall-2025; pnrn-lpn-fall-2025","slug":"practical-nurse","shortDescription":"Want to become an effective and compassionate health care provider? The Bow Valley College Practical Nurse program is for you! This program prepares you to deliver professional nursing care in a complex medical system.","duration":"5-terms","code":"PN","school":"school-of-health-and-wellness","programArea":"health-wellness","pgwp":false},{"name":"Risk Management","programType":"certificate-of-achievement","availableIntakes":"rm-bvc-fall-2025; rm-bvc-winter-2026","slug":"risk-management","shortDescription":"Earn your Canadian Risk Management (CRM) designation in three courses!","duration":"2-terms","code":"RM-BVC","school":"chiu-school-of-business","programArea":"business","pgwp":false},{"name":"Social Work","programType":"diploma","availableIntakes":"sw-fall-2025; sw-winter-2026","slug":"social-work","shortDescription":"A career in social work can be exciting and rewarding. This unique and interesting program has a special multi-cultural focus to help you support a wide range of clients. Are you ready to get started?","duration":"6-terms","code":"SW","school":"school-of-community-studies","programArea":"community-studies","pgwp":false},{"name":"Software Development","programType":"diploma","availableIntakes":"sd-fall-2025; sd-winter-2026","slug":"software-development","shortDescription":"Gain the skills you need to create the latest computer, mobile, and gaming applications. Prepare to transform your ideas into reality all while developing your problem-solving skills.","duration":"4-terms","code":"SD","school":"school-of-technology","programArea":"technology","pgwp":true},{"name":"Software Development - Apprenticeship Style","programType":"diploma","availableIntakes":"sdas-fall-2025; sdas-winter-2026","slug":"software-development---apprenticeship-style","shortDescription":"Gain real-world knowledge and practical experience in today’s software industry. Learn full-stack web development, mobile application development, and cloud and enterprise computing while working in your dream job.","duration":"4-terms","code":"SDAS","school":"school-of-technology","programArea":"technology","pgwp":false},{"name":"Software Development - Post-Diploma Certificate","programType":"post-diploma-certificate","availableIntakes":"sdp-fall-2025; sdp-winter-2026","slug":"software-development---post-diploma-certificate","shortDescription":"Prepare for a career in computer programming, web application development, software testing, and quality control.","duration":"2-terms","code":"SDP","school":"school-of-technology","programArea":"technology","pgwp":true},{"name":"University Transfer","programType":"program","availableIntakes":"","slug":"university-transfer","shortDescription":"Embark on an exciting academic journey by enrolling in University Transfer.","duration":"","code":"UT","school":"school-of-arts-and-sciences","programArea":"","pgwp":false},{"name":"Veterinary Office Assistant","programType":"certificate","availableIntakes":"voa-fall-2025; voa-winter-2026","slug":"veterinary-office-assistant","shortDescription":"If you enjoy spending your day with four-legged friends from the animal kingdom, then this Veterinary Office Assistant program could be for you.","duration":"2-terms","code":"VOA","school":"chiu-school-of-business","programArea":"business","pgwp":false}]}]]}]}]]}],["$","$L8",null,{"children":"$L9"}],null,["$","$La",null,{"children":["$Lb","$Lc",["$","$Ld",null,{"promise":"$@e"}]]}]]}],{},null,false]},null,false]},null,false],["$","$1","h",{"children":[null,["$","$1","oPZPeSu4wMHCJSjaSMZfc",{"children":[["$","$Lf",null,{"children":"$L10"}],null]}],null]}],false]],"m":"$undefined","G":["$11","$undefined"],"s":false,"S":true}
