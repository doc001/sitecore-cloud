{
  "name": "bvc-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "breadcrumbs:build": "node scripts/generateNavigationBreadcrumbs.mjs build",
    "breadcrumbs:validate": "node scripts/generateNavigationBreadcrumbs.mjs validate",
    "breadcrumbs:types": "node scripts/generateNavigationBreadcrumbs.mjs types",
    "breadcrumbs:manifest": "node scripts/generateNavigationBreadcrumbs.mjs manifest",
    "breadcrumbs:all": "node scripts/generateNavigationBreadcrumbs.mjs all",
    "prebuild": "npm run breadcrumbs:all",
    "predev": "npm run breadcrumbs:build",
    "prelaunch:build": "npm run createCourses && node scripts/copy-folders.mjs",
    "postinstall": "flowbite-react patch",
    "getWebflowData": "node scripts/fetch-webflow-collections.mjs",
    "parsePrograms": "node scripts/parsePrograms.mjs",
    "createCourses": "npm run getWebflowData && npm run parsePrograms",
    "generateCourses": "node scripts/export-valid-courses.mjs",
    "generateOpenStudies": "node scripts/export-os-valid-courses.mjs",
    "generateMap": "node scripts/generateSiSData.mjs",
    "generateCourseData": "node scripts/buildCoursesComplete.mjs",
    "generateOpenStudiesData": "node scripts/buildCoursesOpenStudiesComplete.mjs",
    "fetchCourseOutlines": "node scripts/fetchCourseOutlines.mjs",
    "generateNavigationBreadcrumbs": "node scripts/generateNavigationBreadcrumbs.mjs",
    "bvcapp-scripts": "npm run generateCourses && npm run generateOpenStudies && npm run generateMap && npm run generateCourseData && npm run generateOpenStudiesData && npm run generateNavigationBreadcrumbs && npm run prelaunch:build",
    "build": "npm run bvcapp-scripts && next build"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.2",
    "@tailwindcss/postcss": "^4.1.6",
    "@tailwindcss/vite": "^4.1.6",
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "dotenv": "^16.5.0",
    "flowbite-react": "^0.11.7",
    "framer-motion": "^12.10.4",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "next": "15.3.8",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "sass": "^1.87.0",
    "vercel": "^48.2.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.57",
    "@types/node-fetch": "^2.6.12",
    "@types/prop-types": "^15.7.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "browserlist": "^1.0.1",
    "lightningcss": "^1.29.3",
    "node-fetch": "^3.3.2",
    "node-schedule": "^2.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.8",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
