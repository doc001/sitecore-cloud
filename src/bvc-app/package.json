{
  "name": "bvc-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "breadcrumbs:build": "node scripts/generateNavigationBreadcrumbs.mjs build",
    "breadcrumbs:validate": "node scripts/generateNavigationBreadcrumbs.mjs validate",
    "breadcrumbs:types": "node scripts/generateNavigationBreadcrumbs.mjs types",
    "breadcrumbs:manifest": "node scripts/generateNavigationBreadcrumbs.mjs manifest",
    "breadcrumbs:all": "node scripts/generateNavigationBreadcrumbs.mjs all",
    "prebuild": "npm run breadcrumbs:all",
    "predev": "npm run breadcrumbs:build",
    "prelaunch:build": "node scripts/copy-folders.mjs",
    "postinstall": "flowbite-react patch",
    "getWebflowData": "node scripts/fetch-webflow-collections.mjs",
    "js:build": "node scripts/build-os-course.mjs",
    "js:build:prod": "node scripts/build-os-course.mjs --prod",
    "js:watch": "node scripts/build-os-course.mjs --watch",
    "checkout-cart:html": "node scripts/build-checkout-cart-html.mjs",
    "os-course:sandbox": "node dev/os-course/server.mjs",
    "os-course:dev": "node dev/os-course/dev.mjs",
    "generateCourses": "node scripts/generate-courses-to-build.mjs",
    "generateOpenStudies": "node scripts/generate-os-valid-courses.mjs",
    "generateMap": "node scripts/generateSiSData.mjs",
    "generateCourseData": "node scripts/generateExtendedEducation.mjs",
    "generateOpenStudiesData": "node scripts/extract-os-course-data.mjs",
    "generateOpenStudiesJson": "node scripts/generateOpenStudiesPublicJson.mjs",
    "generateOpenStudiesByArea": "node scripts/buildOpenStudiesByArea.mjs",
    "generateExtendedEducationJson": "node scripts/buildExtendedEducationCourses.mjs",
    "sanitizeOutlines": "node scripts/sanitize-outline-filenames.mjs",
    "sanitizeOutlines:check": "node scripts/sanitize-outline-filenames.mjs --dry-run",
    "fetchCourseOutlines": "node scripts/fetchCourseOutlines.mjs",
    "generateNavigationBreadcrumbs": "node scripts/generateNavigationBreadcrumbs.mjs",
    "generateProgramRequirements": "node scripts/generateProgramRequirements.mjs",
    "generateProgramRequirements:check": "node scripts/generateProgramRequirements.mjs --check",
    "generateProgramRequirements:gate": "node scripts/generateProgramRequirements.mjs --check --strict",
    "generateProgramTuition": "node scripts/generateProgramTuition.mjs",
    "generateProgramTuition:check": "node scripts/generateProgramTuition.mjs --check",
    "hourly-scripts:base": "npm run sanitizeOutlines && npm run generateCourses && npm run generateMap && npm run generateCourseData && npm run generateExtendedEducationJson && npm run prelaunch:build",
    "hourly-scripts:os": "npm run generateOpenStudies && npm run generateOpenStudiesData && npm run generateOpenStudiesJson && npm run generateOpenStudiesByArea && npm run prelaunch:build",
    "hourly-scripts": "npm run hourly-scripts:base && npm run hourly-scripts:os",
    "bvcapp-scripts": "npm run sanitizeOutlines && npm run getWebflowData && npm run generateCourses && npm run generateOpenStudies && npm run generateMap && npm run generateCourseData && npm run generateOpenStudiesData && npm run generateOpenStudiesJson && npm run generateOpenStudiesByArea && npm run generateExtendedEducationJson && npm run generateNavigationBreadcrumbs && npm run generateProgramRequirements && npm run prelaunch:build",
    "build": "npm run js:build && npm run bvcapp-scripts && next build",
    "cleanup": "node scripts/cleanup-data.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.2",
    "@tailwindcss/postcss": "^4.1.6",
    "@tailwindcss/vite": "^4.1.6",
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "dotenv": "^16.5.0",
    "eslint-config-next": "^16.1.6",
    "flowbite-react": "^0.11.7",
    "framer-motion": "^12.10.4",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "next": "16.2.6",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "sass": "^1.87.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.57",
    "@types/node-fetch": "^2.6.12",
    "@types/prop-types": "^15.7.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "browserlist": "^1.0.1",
    "esbuild": "^0.28.1",
    "lightningcss": "^1.29.3",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.8",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
